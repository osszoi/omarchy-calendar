#!/usr/bin/env python3
"""Fire one meeting alert, exactly once.

The bar runs one instance per monitor and every instance ticks on its own, so
the "has this already fired" check and the write have to happen under a lock —
otherwise a two-screen setup means two toasts for the same meeting.
"""

import argparse
import fcntl
import json
import os
import subprocess
import sys
from datetime import datetime
from urllib.parse import urlparse

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import _common as C

ALERTED_PATH = os.path.join(C.CACHE_DIR, "alerted.json")
LOCK_PATH = os.path.join(C.CACHE_DIR, "alerted.lock")
GLYPH = "\U000f00ed"


def claim(keys):
    """True if we won the race for these keys; False if someone already sent it."""
    os.makedirs(C.CACHE_DIR, exist_ok=True)
    with open(LOCK_PATH, "a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        fired = C.read_json(ALERTED_PATH, {}) or {}
        if any(key in fired for key in keys):
            return False
        now = C.now_epoch()
        # Keys are per meeting occurrence, so the file would otherwise grow for
        # the life of the install. A week is far past any catch-up window.
        fired = {k: v for k, v in fired.items() if now - int(v or 0) < 7 * 86400}
        for key in keys:
            fired[key] = now
        C.write_json_atomic(ALERTED_PATH, fired)
        return True


def clock(epoch):
    return datetime.fromtimestamp(int(epoch)).strftime("%H:%M")


def headline(title, lead, late, start):
    if late:
        minutes = max(0, (C.now_epoch() - int(start)) // 60)
        if minutes <= 0:
            return "%s is starting" % title
        return "%s started %d min ago" % (title, minutes)
    if lead <= 1:
        return "%s in 1 min" % title
    return "%s in %d min" % (title, lead)


def description(args):
    parts = ["%s - %s" % (clock(args.when), clock(args.end))] if args.end else [clock(args.when)]
    if args.account:
        parts.append(args.account)
    target = args.link or args.location
    if target:
        host = urlparse(target).netloc if "://" in target else target
        parts.append(host)
    return " · ".join(parts)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--keys", required=True, help="comma separated dedupe keys")
    parser.add_argument("--title", required=True)
    parser.add_argument("--when", type=int, required=True)
    parser.add_argument("--end", type=int, default=0)
    parser.add_argument("--lead", type=int, default=1)
    parser.add_argument("--late", type=int, default=0)
    parser.add_argument("--account", default="")
    parser.add_argument("--location", default="")
    parser.add_argument("--link", default="")
    args = parser.parse_args()

    keys = [k for k in args.keys.split(",") if k]
    if not keys or not claim(keys):
        return 3

    command = [
        "omarchy-notification-send",
        "-u", "critical",
        "-g", GLYPH,
        headline(args.title, args.lead, bool(args.late), args.when),
        description(args),
    ]
    if args.link:
        command += ["--exec", "omarchy-launch-browser", args.link]

    subprocess.run(command, check=False)
    return 0


if __name__ == "__main__":
    sys.exit(main())
